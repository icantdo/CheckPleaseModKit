<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CheckPlease.ModKit</AssemblyName>
    <RootNamespace>CheckPlease.ModKit</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <ManagedDir>$(GameDir)\CheckPlease_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(ManagedDir)\CheckPlease.Runtime.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine*.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(ManagedDir)\DOTween*.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>

  <!-- Copy the built plugin into the game's BepInEx/plugins folder -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(AssemblyName).xml" DestinationFolder="$(GameDir)\BepInEx\plugins\CheckPlease.ModKit" />
  </Target>
</Project>
